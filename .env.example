# Mot de passe unique partagé avec le client (6 caractères minimum).
PORTAL_PASSWORD=remplacez-moi-ici

# Clé HMAC qui signe le cookie de session. Laissée vide, PORTAL_PASSWORD sert de clé,
# mais une clé séparée évite qu'un changement de mot de passe déconnecte tout le monde.
PORTAL_SECRET=une-cle-aleatoire-longue

# Lien de redéploiement de l'hébergeur (Vercel Deploy Hook ou Netlify Build Hook).
# Optionnel : sans lui, le bouton « Actualiser » du portail reste masqué.
REDEPLOY_HOOK_URL=
